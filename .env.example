# Copy to .env (never commit .env).

# Public URL of the deployed site — used for canonical/OG tags and sitemap.xml.
# Falls back to profile.site.url in src/data/profile.js.
VITE_SITE_URL=https://your-domain.example

# Contact form endpoint (Formspree / Web3Forms / any service that accepts a POST of form fields
# and returns JSON). Leave empty to fall back to a mailto: link.
VITE_FORM_ENDPOINT=
